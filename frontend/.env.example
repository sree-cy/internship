# PrepGo Frontend Environment Configuration Template
# Copy this file to .env in production or local development.

# Backend API Base URL (Do NOT add trailing slash)
# Local development: http://localhost:5000
# Production: https://your-backend.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# Google OAuth 2.0 Web Client ID (matches backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
