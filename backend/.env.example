# PrepGo Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/prepgo?retryWrites=true&w=majority

# JWT Authentication Secret Key (generate a secure random 32+ char string)
JWT_SECRET=your_jwt_secret_key_here

# Gmail SMTP Configuration for Nodemailer (Email Verification & Password Reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Production CORS Configuration (Comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Optional: Sandboxed Code Execution Service (Piston API for isolated multi-language code execution)
PISTON_API_URL=https://emkc.org/api/v2/piston
